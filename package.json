{
  "name": "sunset-esports-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "test": "node --test",
    "preview": "vite preview",
    "start": "node server/index.js",
    "setup:admin": "node scripts/setup-admin.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
